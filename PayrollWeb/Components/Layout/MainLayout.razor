@inherits LayoutComponentBase
@implements IDisposable
@inject ToastService Toasts
@inject AuthState Auth
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted">Indian Payroll - FY 2025-26</span>
            @if (Auth.IsLoggedIn)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-light">@Auth.Username (@Auth.Role)</span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LogoutAsync">Logout</button>
                </div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (Toasts.Current is { } toast)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast show border-0 text-bg-@toast.Type" role="alert">
            <div class="d-flex">
                <div class="toast-body">@toast.Message</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="Toasts.Clear" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Toasts.OnChange += OnToastChanged;
    }

    private void OnToastChanged() => _ = InvokeAsync(StateHasChanged);

    private void LogoutAsync()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose() => Toasts.OnChange -= OnToastChanged;
}
