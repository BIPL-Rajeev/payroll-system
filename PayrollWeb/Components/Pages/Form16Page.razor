@page "/form16/{employeeId:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using PayrollApi.Core.Services
@inject ApiClient Api
@inject HttpClient Http
@inject ToastService Toasts

<PageTitle>Form 16 - PayrollWeb</PageTitle>

<h3 class="mb-3">Form 16 (Part B)</h3>

@if (loading)
{
    <Spinner Text="Loading employees..." />
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="f16-emp">Employee</label>
                    <InputSelect id="f16-emp" class="form-select" @bind-Value="selectedEmployeeId">
                        @foreach (var e in employees)
                        {
                            <option value="@e.Id">@e.EmployeeCode - @e.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="f16-fy">Financial Year</label>
                    <InputSelect id="f16-fy" class="form-select" @bind-Value="financialYear">
                        @foreach (var fy in financialYears)
                        {
                            <option value="@fy">@fy</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary" disabled="@busy || selectedEmployeeId == 0" @onclick="GenerateAsync">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Generate Form 16
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (form is not null)
    {
        <div class="d-flex justify-content-between align-items-center mb-2 no-print">
            <span class="text-muted">Generated on @form.GeneratedOn</span>
            <a class="btn btn-success" href="@PdfUrl" target="_blank" rel="noopener">⬇ Download PDF</a>
        </div>

        <!-- SECTION 1 -->
        <div class="card mb-3">
            <div class="card-header">Section 1: Employee &amp; Employer Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Employee Name</dt><dd class="col-sm-7">@form.EmployeeDetails.EmployeeName</dd>
                            <dt class="col-sm-5">PAN</dt><dd class="col-sm-7">@form.EmployeeDetails.EmployeePan</dd>
                            <dt class="col-sm-5">Employee Code</dt><dd class="col-sm-7">@form.EmployeeDetails.EmployeeCode</dd>
                            <dt class="col-sm-5">Tax Regime</dt><dd class="col-sm-7">@form.EmployeeDetails.TaxRegime</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Employer Name</dt><dd class="col-sm-7">@form.EmployeeDetails.Employer.EmployerName</dd>
                            <dt class="col-sm-5">Employer PAN</dt><dd class="col-sm-7">@form.EmployeeDetails.Employer.EmployerPan</dd>
                            <dt class="col-sm-5">Employer TAN</dt><dd class="col-sm-7">@form.EmployeeDetails.Employer.EmployerTan</dd>
                            <dt class="col-sm-5">FY / AY</dt><dd class="col-sm-7">@form.EmployeeDetails.FinancialYear / @form.EmployeeDetails.AssessmentYear</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2 -->
        <div class="card mb-3">
            <div class="card-header">Section 2: Gross Salary (Annual)</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @Row("Basic Salary", form.GrossSalary.Basic)
                        @Row("HRA Received", form.GrossSalary.Hra)
                        @Row("DA", form.GrossSalary.Da)
                        @Row("Special Allowance", form.GrossSalary.SpecialAllowance)
                        @Row("LTA", form.GrossSalary.Lta)
                        @Row("Other Allowances", form.GrossSalary.OtherAllowances)
                        @Row("Total Gross Salary", form.GrossSalary.Total, bold: true)
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="card mb-3">
            <div class="card-header">Section 3: Exemptions &amp; Deductions (Section 10)</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @Row("HRA Exemption u/s 10(13A)", form.Exemptions.HraExemption)
                        @Row("LTA Exemption", form.Exemptions.LtaExemption)
                        @Row("Standard Deduction u/s 16(ii)", form.Exemptions.StandardDeduction)
                        @Row("Professional Tax u/s 16(iii)", form.Exemptions.ProfessionalTax)
                        @Row("Total Exemptions", form.Exemptions.Total, bold: true)
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECTION 4 -->
        <div class="card mb-3 border-primary">
            <div class="card-header bg-primary-subtle">Section 4: Income Chargeable under Salaries</div>
            <div class="card-body d-flex justify-content-between">
                <span>Gross Salary - Total Exemptions</span>
                <strong>@Inr.Format(form.IncomeChargeableUnderSalaries)</strong>
            </div>
        </div>

        <!-- SECTION 5 -->
        <div class="card mb-3">
            <div class="card-header">Section 5: Deductions under Chapter VI-A</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @Row("80C (max Rs 1,50,000)", form.ChapterVIA.Section80C)
                        @Row("80CCD(1B) (max Rs 50,000)", form.ChapterVIA.Section80CCD1B)
                        @Row("80D (max Rs 25,000 + 50,000 senior)", form.ChapterVIA.Section80D)
                        @Row("80TTA (max Rs 10,000)", form.ChapterVIA.Section80TTA)
                        @Row("80CCD(2) - Employer NPS (both regimes)", form.ChapterVIA.Section80CCD2)
                        @Row("Total Chapter VI-A", form.ChapterVIA.Total, bold: true)
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECTION 6 -->
        <div class="card mb-3 border-primary">
            <div class="card-header bg-primary-subtle">Section 6: Taxable Income (rounded to nearest Rs 10)</div>
            <div class="card-body d-flex justify-content-between">
                <span>Income under Salaries - Chapter VI-A</span>
                <strong>@Inr.Format(form.TaxableIncome)</strong>
            </div>
        </div>

        <!-- SECTION 7 -->
        <div class="card mb-3">
            <div class="card-header">Section 7: Tax Computation (@form.Tax.TaxRegime Regime)</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @Row("Tax on Taxable Income", form.Tax.TaxBeforeRebate)
                        @Row("Section 87A Rebate", -form.Tax.Rebate87A)
                        @Row("Surcharge", form.Tax.Surcharge)
                        @Row("Marginal Relief", -form.Tax.MarginalRelief)
                        @Row("Health & Education Cess (4%)", form.Tax.Cess)
                        @Row("Total Tax Payable", form.Tax.TotalTaxPayable, bold: true)
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SECTION 8 -->
        <div class="card mb-4">
            <div class="card-header">Section 8: TDS Summary</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @Row("Total TDS deducted during the year", form.Tds.TotalTdsDeducted)
                        @Row("Balance Tax Payable", form.Tds.BalanceTaxPayable, bold: true)
                        @Row("Refund", form.Tds.Refund, bold: true)
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int EmployeeId { get; set; }

    private bool loading = true;
    private bool busy;
    private List<ApiEmployee> employees = [];
    private List<string> financialYears = [];
    private int selectedEmployeeId;
    private string financialYear = string.Empty;
    private Form16PartB? form;

    private string PdfUrl => $"{Http.BaseAddress}api/form16/{selectedEmployeeId}/{financialYear}/pdf";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees = await Api.GetEmployeesAsync();
            financialYears = LastThreeFinancialYears();
            selectedEmployeeId = employees.Any(e => e.Id == EmployeeId)
                ? EmployeeId
                : employees.FirstOrDefault()?.Id ?? 0;
            financialYear = financialYears[0];
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GenerateAsync()
    {
        busy = true;
        form = null;
        try
        {
            form = await Api.GetForm16Async(selectedEmployeeId, financialYear);
            Toasts.ShowSuccess($"Form 16 for FY {financialYear} generated.");
        }
        catch (Exception ex)
        {
            Toasts.ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private static List<string> LastThreeFinancialYears()
    {
        DateTime now = DateTime.Now;
        int current = now.Month >= 4 ? now.Year : now.Year - 1;
        return
        [
            Format(current),
            Format(current - 1),
            Format(current - 2),
        ];

        static string Format(int startYear) => $"{startYear}-{(startYear + 1) % 100:00}";
    }

    private static RenderFragment Row(string label, decimal amount, bool bold = false) => builder =>
    {
        builder.OpenElement(0, "tr");
        builder.OpenElement(1, "td");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "td");
        builder.AddAttribute(4, "class", bold ? "text-end fw-bold" : "text-end");
        builder.AddContent(5, Inr.Format(amount));
        builder.CloseElement();
        builder.CloseElement();
    };
}
