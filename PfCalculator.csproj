<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- This project lives at the repo root, so the SDK default glob would otherwise
       compile EVERY .cs file in the tree (all calculator entry points top-level
       statements, test files ...). Scope the compile set to this project only. -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
